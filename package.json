{
  "name": "ojtrace",
  "version": "0.1.4",
  "description": "A local-first cross-OJ submission timeline extension",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "audit:manifest": "node tools/audit-manifest.mjs",
    "audit:architecture": "node tools/audit-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src entrypoints tests *.ts",
    "test:contract": "vitest run tests/adapters tests/domain",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"entrypoints/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json}\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.28.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@myriaddreamin/typst-all-in-one.ts": "0.7.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "lucide-react": "^1.51.0",
    "marked": "18.1.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wxt": "0.21.4"
  }
}
