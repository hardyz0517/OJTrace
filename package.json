{
  "name": "ojtrace",
  "version": "0.1.0",
  "description": "A local-first cross-OJ submission timeline extension",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "audit:manifest": "node tools/audit-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src entrypoints tests *.ts",
    "test:contract": "vitest run tests/adapters tests/domain",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"entrypoints/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json}\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.28.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wxt": "0.21.4"
  }
}
